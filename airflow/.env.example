# The secrets of the Airflow compose project (docker-compose.yaml; D26). Copy this file to airflow/.env (git ignores that one) and give each name a value; the compose file has no
# default for any of them and refuses to start until each is set. Nothing here is a real value: never commit airflow/.env.
#
# INVOICEFLOW_DB_PASSWORD: the password of the PostgreSQL that holds Airflow's metadata.
#   python -c "import secrets; print(secrets.token_hex(24))"
INVOICEFLOW_DB_PASSWORD=
# INVOICEFLOW_FERNET_KEY: encrypts the connections and variables Airflow stores (32 bytes, URL-safe base64).
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
INVOICEFLOW_FERNET_KEY=
# INVOICEFLOW_JWT_SECRET: signs the tokens between the Airflow services.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INVOICEFLOW_JWT_SECRET=
# INVOICEFLOW_ADMIN_PASSWORD: the password of the Airflow user `airflow` (http://localhost:8080).
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
INVOICEFLOW_ADMIN_PASSWORD=
# INVOICEFLOW_API_TOKEN: the token of the entry API (`Authorization: Bearer <token>`); only the `api` service gets it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INVOICEFLOW_API_TOKEN=
# INVOICEFLOW_ERP_TOKEN: the token the stand-in of the ERP (service `erp`) accepts and the DAG and the API send; with a real ERPNext it is that server's API key and secret.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INVOICEFLOW_ERP_TOKEN=
